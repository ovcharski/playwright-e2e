{
  "name": "playwright-e2e",
  "version": "1.0.0",
  "description": "Playwright E2E testing framework for a WooCommerce demo shop, built to teach QA automation",
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "Nikola Ovcharski",
  "license": "Apache-2.0",
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "dotenv": "^18.0.3",
    "eslint": "^10.11.0",
    "eslint-plugin-playwright": "^2.12.0",
    "husky": "^9.1.7",
    "typescript": "^6.0.3"
  }
}
